# LangSmith (docs/07) — confirmadas
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blinka-invoice-agent-dev
LANGSMITH_ENDPOINT=

# LLM (OpenAI-compatible chat completions)
LLM_BASE_URL=
LLM_API_KEY=
EXTRACTOR_MODEL=
VERIFIER_MODEL=
POLISHER_MODEL=
POLISHER_ENABLED=false

# JEV / TypeSafe systemone
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Decision path: auto | jev | plan_b
DECISION_BACKEND=auto
HTTP_TIMEOUT_SECONDS=30

# In-process HTTP limit per client IP (T4.1). Not a secret.
API_RATE_LIMIT_PER_MINUTE=60

# SQLite dev file (T4.2). Postgres URL is wired in T4.9.
DATABASE_URL=sqlite:///./blinka.sqlite
