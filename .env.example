# LangSmith (docs/07) — confirmadas
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=blinka-invoice-agent-dev
LANGSMITH_ENDPOINT=

# LLM (OpenAI-compatible chat completions)
LLM_BASE_URL=
LLM_API_KEY=
EXTRACTOR_MODEL=
VERIFIER_MODEL=
POLISHER_MODEL=
POLISHER_ENABLED=false

# JEV / TypeSafe systemone
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Decision path: auto | jev | plan_b
DECISION_BACKEND=auto
HTTP_TIMEOUT_SECONDS=30

# In-process HTTP limit per client IP (T4.1). Not a secret.
API_RATE_LIMIT_PER_MINUTE=60

# SQLite dev file (T4.2). For Supabase Postgres use the pooled URI (see docs/SUPABASE_SETUP.md).
DATABASE_URL=sqlite:///./blinka.sqlite

# Optional: Supabase project ref for documentation only (not read by the API).
SUPABASE_PROJECT_REF=

# Comma-separated exact browser origins allowed to call the API (no paths, never *).
# Leave empty for local dev (Next.js proxy is same-origin). Set in Render when Vercel URL exists.
CORS_ORIGINS=

# Shared admin secret for PUT /rules, approve, and reject (T5.9, D055). Compared with
# hmac.compare_digest; unset means those endpoints fail closed with 503. Set it in
# Render with sync: false, never commit the real value.
ADMIN_API_KEY=
