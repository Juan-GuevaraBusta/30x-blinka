# Local backend. On Vercel set API_URL to the public API origin (https://…, no path, no API key).
API_URL=http://127.0.0.1:8000

# Server-side only (T5.9, D055): injected into X-Admin-Key by the proxy routes under
# app/api/**. Must equal the backend's ADMIN_API_KEY. Set in Vercel as a server env
# var, never NEXT_PUBLIC_*, so the browser never sees it.
ADMIN_API_KEY=
